# Finora Root Environment Configuration

# Server Environment
PORT=5000
DATABASE_URL="file:./dev.db"
# For production PostgreSQL (Supabase / Neon / Render / Railway):
# DATABASE_URL="postgresql://postgres:password@db.xyz.supabase.co:5432/postgres?sslmode=require"

JWT_SECRET="finora-secret-key-32-chars-minimum-token-protection-jwt-2026"
JWT_REFRESH_SECRET="finora-refresh-secret-key-token-protection-2026"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"
