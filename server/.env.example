PORT=5000
# For local SQLite:
DATABASE_URL="file:./dev.db"

# For PostgreSQL in production (e.g., Supabase / Neon / Render / Railway):
# DATABASE_URL="postgresql://postgres:password@db.xyz.supabase.co:5432/postgres?sslmode=require"

JWT_SECRET="replace-with-a-secure-random-32-byte-secret"
JWT_REFRESH_SECRET="replace-with-a-secure-random-refresh-secret"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"
